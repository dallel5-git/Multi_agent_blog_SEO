# =============================================================================
#  blogseo-agents — configuration
#  Copiez ce fichier en `.env` puis remplissez les valeurs.
#
#  RÈGLE ABSOLUE : aucune clé n'est jamais écrite dans le code.
#  `.env` est dans .gitignore — ne le commitez JAMAIS.
#
#  TOUS les services listés ici ont un free tier PERMANENT,
#  sans carte bancaire requise.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM — chaîne 100 % free tier, sans exception (voir ADR 0008).
# Ordre d'essai : Groq → OpenRouter (2 modèles) → Gemini. Seuls les
# fournisseurs dont la clé est renseignée entrent dans la chaîne ; au moins
# un est nécessaire (sinon repli sur le LLM factice, articles d'exemple).
# Renseignez-en un seul pour démarrer (Groq recommandé, le plus fiable en
# pratique), ou plusieurs pour maximiser la résilience aux pannes/quotas.
#
# Cerebras a été essayé puis retiré : le compte testé exige une facturation
# activée pour l'inférence (HTTP 402) malgré le free tier annoncé — ça viole
# la règle « jamais de carte bancaire ». L'adapter CerebrasLLM reste dans le
# code (infrastructure/llm/cerebras.py) pour qui a un compte sans cette
# restriction ; il suffit de l'ajouter à `Container.llm`.
# -----------------------------------------------------------------------------

# 1. Groq — https://console.groq.com/keys
#    llama-3.3-70b-versatile n'existe plus ; openai/gpt-oss-20b est rapide et
#    compatible JSON strict (testé). Autres modèles gratuits : voir
#    https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_RPM=30
GROQ_RPD=14400

# 2-3. OpenRouter — https://openrouter.ai/keys (une seule clé, deux modèles)
#    Agrège plusieurs modèles gratuits (suffixe ":free", 0 $ garanti). Deux
#    modèles différents plutôt qu'un seul : un modèle ":free" peut devenir
#    payant du jour au lendemain (vécu avec meta-llama/llama-3.3-70b-instruct)
#    ou être rate-limité indépendamment de l'autre. Les deux valeurs par
#    défaut sont vérifiées (texte simple + JSON strict). Liste à jour :
#    https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_2=openai/gpt-oss-20b:free
OPENROUTER_RPM=20
OPENROUTER_RPD=200

# 4. Google Gemini — https://aistudio.google.com/apikey
#    En dernier recours dans la chaîne : un projet Google suspendu ou non
#    éligible renvoie HTTP 403 quel que soit le modèle. Quotas à jour :
#    https://ai.google.dev/pricing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_RPM=15
GEMINI_RPD=1500

# Réglages communs aux LLM
LLM_TEMPERATURE_CREATIVE=0.75      # Content Writer
LLM_TEMPERATURE_ANALYTIC=0.25      # analyse, SEO, relecture
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_S=120

# -----------------------------------------------------------------------------
# 3. RECHERCHE WEB
#    DuckDuckGo est utilisé par défaut et NE DEMANDE AUCUNE CLÉ.
#    Tavily est un repli optionnel (free tier : 1000 requêtes/mois).
#    Clé : https://tavily.com
# -----------------------------------------------------------------------------
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=8
SEARCH_DELAY_S=2.0                 # anti-blocage DuckDuckGo

# -----------------------------------------------------------------------------
# 4. SOURCES DE VEILLE (toutes publiques et gratuites, aucune clé)
# -----------------------------------------------------------------------------
HN_LIMIT=20
DEVTO_TAGS=ai,automation,python,webdev
REDDIT_SUBREDDITS=artificial,LocalLLaMA,n8n,automation,Python,AI_Agents

# Flux RSS de médias tunisiens, séparés par des virgules.
# Vérifiés à la main (HTTP 200, RSS valide, contenu à jour) — voir issue #38.
# Laissez vide pour désactiver cette source ; sinon la valeur ci-dessous
# (5 flux) est déjà le comportement par défaut si la ligne est absente.
#   - Tekiano          : tech & culture numérique tunisienne
#   - Économiste Maghrébin (tag startup) : levées de fonds, Startup Act
#   - Espace Manager (catégorie économie) : investissement, PME, commerce
#   - African Manager  : business & économie Tunisie/Afrique
#   - Kapitalis (Tunisie) : actualité tunisienne généraliste
TUNISIA_RSS_FEEDS=https://www.tekiano.com/feed/,https://www.leconomistemaghrebin.com/tag/startup/feed/,https://www.espacemanager.com/category/economie/feed,https://africanmanager.com/feed/,https://kapitalis.com/tunisie/feed/

# -----------------------------------------------------------------------------
# 5. NOTIFICATIONS ET VALIDATION HUMAINE — Telegram (gratuit)
#    a) Créez un bot avec @BotFather sur Telegram → vous recevez le token
#    b) Écrivez un message à votre bot, puis ouvrez dans un navigateur :
#       https://api.telegram.org/bot<VOTRE_TOKEN>/getUpdates
#       → le champ result[0].message.chat.id est votre TELEGRAM_CHAT_ID
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REVIEW_TIMEOUT_S=86400    # 24 h d'attente maximum de votre décision
TELEGRAM_POLL_INTERVAL_S=5
# Action appliquée si vous ne répondez pas dans le délai : reject | approve
# « reject » = l'article est écrit en local, vous pousserez vous-même. C'est le choix sûr.
TELEGRAM_DEFAULT_ON_TIMEOUT=reject

# -----------------------------------------------------------------------------
# 6. VALIDATION HUMAINE
#    true  → le pipeline s'arrête avant publication et attend votre décision
#    false → publication automatique (à n'activer qu'après plusieurs dry-runs)
# -----------------------------------------------------------------------------
HUMAN_REVIEW=true

# -----------------------------------------------------------------------------
# 7. BLOG NEXT.JS — chemins sur VOTRE machine
# -----------------------------------------------------------------------------
BLOG_CONTENT_DIR=/home/oussama/Bureau/Chaine_youtube_Oussama_Dallel/Blog IA/oussama-blog/content/articles
BLOG_REPO_DIR=/home/oussama/Bureau/Chaine_youtube_Oussama_Dallel/Blog IA/oussama-blog
BLOG_COVER_DIR=/home/oussama/Bureau/Chaine_youtube_Oussama_Dallel/Blog IA/oussama-blog/public/covers
BLOG_GIT_BRANCH=main
BLOG_GIT_REMOTE=origin
ENABLE_COVER_GENERATION=true

# -----------------------------------------------------------------------------
# 8. LIGNE ÉDITORIALE ET QUALITÉ
# -----------------------------------------------------------------------------
ARTICLE_AUTHOR=Oussama Dallel
ARTICLE_MIN_WORDS=1200
ARTICLE_MAX_WORDS=2000
MAX_REVISIONS=2                    # allers-retours Quality Gate → Content Writer
DUPLICATE_THRESHOLD=0.85           # similarité cosinus au-delà de laquelle un sujet est rejeté

# -----------------------------------------------------------------------------
# 9. SEARCH CONSOLE (optionnel, gratuit) — boucle de rétroaction performance
#    Ferme la seconde boucle du pipeline : sans ceci, le Keyword Analyst
#    choisit ses sujets sans savoir ce qui marche déjà sur le blog.
#
#    a) Créez un projet sur https://console.cloud.google.com/ (gratuit)
#    b) Activez l'API « Search Console API »
#       (API et services → Bibliothèque → chercher "Search Console API")
#    c) Identifiants → Créer des identifiants → ID client OAuth
#       → type d'application « Application de bureau »
#       → copiez le Client ID / Client secret ci-dessous
#    d) Ajoutez votre blog comme propriété dans
#       https://search.google.com/search-console (si ce n'est pas déjà fait)
#    e) Lancez `python scripts/search_console_oauth.py` (après avoir renseigné
#       CLIENT_ID/CLIENT_SECRET) : il ouvre votre navigateur, puis affiche la
#       ligne SEARCH_CONSOLE_REFRESH_TOKEN à coller ici.
#
#    Non configuré → repli automatique sur un export manuel déposé dans
#    storage/analytics/performance.json (aucune régression).
# -----------------------------------------------------------------------------
# URL exacte de la propriété Search Console : "https://exemple.com/" pour une
# propriété "préfixe d'URL", ou "sc-domain:exemple.com" pour une propriété "domaine".
SEARCH_CONSOLE_SITE_URL=
SEARCH_CONSOLE_CLIENT_ID=
SEARCH_CONSOLE_CLIENT_SECRET=
SEARCH_CONSOLE_REFRESH_TOKEN=

# -----------------------------------------------------------------------------
# 10. TECHNIQUE
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2   # local, CPU, sans clé
ORCHESTRATOR=langgraph             # langgraph | sequential
LOG_LEVEL=INFO
DRY_RUN=false
# STORAGE_DIR=/chemin/absolu/vers/storage   # par défaut : <projet>/storage
